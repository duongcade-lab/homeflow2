# HomeFlow - environment variables (placeholders only, never commit real values)

# Values marked [REDACTED:...] are intentionally blank - paste the real value
# from your Supabase/Google dashboards into Vercel, never into this file.

# Supabase - Google Sign-In (browser-safe values only)
# Project URL + anon/publishable key from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=[REDACTED:env-supabase_anon_key]

# Google AI Studio - LLM brain-dump parser (api/parse)
GEMINI_API_KEY=[REDACTED:env-gemini_api_key]
